{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.0",
  "default_locale": "en",
  "icons": {
    "16": "browser/icons/icon-16.png",
    "32": "browser/icons/icon-32.png",
    "48": "browser/icons/icon-48.png",
    "128": "browser/icons/icon-128.png"
  },
  "background": {
    "service_worker": "browser/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "browser/icons/icon-16.png",
      "32": "browser/icons/icon-32.png",
      "48": "browser/icons/icon-48.png",
      "128": "browser/icons/icon-128.png"
    },
    "default_popup": "browser/tab.html"
  },
  "permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://skills.sh/*",
    "https://www.skills.sh/*",
    "https://agentsdirectory.dev/*",
    "https://www.agentsdirectory.dev/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://skills.sh/*",
        "https://www.skills.sh/*",
        "https://agentsdirectory.dev/*",
        "https://www.agentsdirectory.dev/*"
      ],
      "js": [
        "browser/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
